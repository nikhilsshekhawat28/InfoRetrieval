# ─────────────────────────────────────────────
#  InfoStore v2 — Environment Configuration
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Device: auto | cuda | mps | cpu
# "auto" picks the best available (CUDA > MPS > CPU)
DEVICE_PREFERENCE=auto

# ── ChromaDB ──────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=info_store

# ── AI / ML Models ────────────────────────────
# Path to fine-tuned BLIP LoRA adapter (falls back to base BLIP if not found)
BLIP_MODEL_PATH=../models/blip_finetuned

# T5 summarization model (local path or HuggingFace model ID)
SUMMARIZER_MODEL=google/flan-t5-base

# Embedding model (must be a SentenceTransformers-compatible model)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Ollama model name for answer generation
RAG_LLM_MODEL=granite3.1-dense:2b

# ── Text Chunking ─────────────────────────────
# Target word count per chunk (keep below ~380 to fit cross-encoder 512-token limit)
CHUNK_SIZE=300

# Words of overlap between consecutive chunks
CHUNK_OVERLAP=80

# ── Advanced Retrieval ────────────────────────
# Adds an Ollama-generated context prefix to each chunk during indexing.
# Improves retrieval quality but makes indexing much slower (1 LLM call per chunk).
# Disable when doing bulk indexing; enable for selective high-priority docs.
ENABLE_CONTEXTUAL_RETRIEVAL=False

# ── File Watching ─────────────────────────────
# Comma-separated list of directories to auto-monitor for new files
# Windows:      C:/Users/username/Documents/InfoStore/docs,C:/Users/username/Pictures
# macOS/Linux:  ~/Documents/InfoStore/notes,~/Pictures/InfoStore
WATCH_DIRS=

# Absolute path to your Chrome Bookmarks JSON file
# Windows:  C:/Users/username/AppData/Local/Google/Chrome/User Data/Default/Bookmarks
# macOS:    /Users/username/Library/Application Support/Google/Chrome/Default/Bookmarks
# Linux:    /home/username/.config/google-chrome/Default/Bookmarks
BOOKMARK_PATH=

# ── Server ────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
